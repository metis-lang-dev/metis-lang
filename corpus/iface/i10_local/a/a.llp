catalog a 1.
layers (dyn).
stages (act).
include "../../_common/capacity.llp".
include "../../_common/proto.llp".
include "../../_common/iface_mini.llp".
namespace na produce (dyn).
pred extra(thing) : na.
stage act {
  %% a sees a thing and asks about it.
  look [dyn] : seen(T) -o ask(T).
  %% a takes the answer.
  take [dyn] : answer(T) -o extra(T).
}
