% director — the director over MiniHack's hierarchy, installed for the agent (world/mh_hier.py).
catalog director 1.
provenance text "generated: the director over nav/act/task" "2026-10-25".
include "../../director_domain.llp".
include "iface/director_tree_domain.llp".
include "iface/director_tree_wake.llp".
type domain {nav act task}.
type kind {cleared closed done fight goto guarded open opened reach reached refused stuck}.

specialist(nav).
specialist(act).
planner(task).
handles(nav, goto).
handles(act, open).
handles(act, fight).
handles(task, reach).
handles(task, reached).
handles(task, opened).
handles(task, cleared).
handles(task, refused).
result(reached).
result(opened).
result(cleared).
end(stuck).
finished(done).
detour(closed, open).
detour(guarded, fight).
escalate(closed, refused).
escalate(guarded, refused).
rename(closed, open, open).
rename(guarded, fight, fight).
rename(closed, refused, refused).
rename(guarded, refused, refused).

type resource {motion}.
mature_grant(a1).
mature_grant(a2).
mature_grant(a3).
young_grant(a0).
mature_status(a1).
mature_status(a2).
mature_status(a3).

