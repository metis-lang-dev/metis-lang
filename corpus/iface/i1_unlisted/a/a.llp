catalog a 1.
layers (dyn).
stages (act).
include "../capacity.llp".
include "../proto.llp".
include "../iface_mini.llp".
namespace na produce (dyn).
pred note(thing) : na.
stage act {
  %% a sees a thing and asks about it.
  look [dyn] : seen(T) -o ask(T) * note(T).
  %% a takes the answer.
  take [dyn] : answer(T) -o ().
}
