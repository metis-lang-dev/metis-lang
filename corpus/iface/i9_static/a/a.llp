catalog a 1.
layers (dyn).
stages (act).
include "../capacity.llp".
include "../proto.llp".
include "../iface_mini.llp".
bwd near(thing).
near(t1).
stage act {
  %% a sees a thing and asks about it.
  look [dyn] : seen(T) * $near(T) -o ask(T).
  %% a takes the answer.
  take [dyn] : answer(T) -o ().
}
