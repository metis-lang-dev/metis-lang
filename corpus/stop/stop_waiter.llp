% stop_waiter — the standard director unit's stop (toolchain-units s-ddaed776): a stop while d2 holds r and d1's ticket waits: the stop passes the ticket over, then frees r; d1 is never granted.
% Gate 22 replays it over 10 seeds: exactly one stop_release (one revoke), one stop_dequeue and no grant on every seed.
catalog stop_waiter 1.
provenance text "the director's stop with a waiting want" "2026-10-29".
include "iface/director_tree_domain.llp".
include "types.llp".
type kind {none}.
bwd specialist(domain).
specialist(d1).
specialist(d2).
young_grant(a0).
young_grant(a1).
mature_grant(a2).
mature_grant(a3).
mature_status(a1).
mature_status(a2).
mature_status(a3).
#init tick__stop 1
#init nocommit(d1) 1
#init nocommit(d2) 1
#init holder(d2, r) 1
#init held(d2, a1) 1
#init queued(d1, r, t1) 1
#init serving(r, t1) 1
#init issue(r, t2) 1
#init path(d1) 1
#init path(d2) 1
#init tick__goal(d1) 1
#init tick__goal(d2) 1
#init age_of(d1, a0) 1
#init age_of(d2, a0) 1
#steps 20
#seeds 10
