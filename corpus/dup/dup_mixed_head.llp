% dup_mixed_head: a rule's alternative heads hold its name: a link of that name is refused.
catalog dup_mixed_head 1.
provenance text "a rule and a link, one space of names (spec/18 §4)" "2026-11-02".
layers (dyn).
stages (act done).
namespace d produce (dyn).
pred p : d.
pred q : d.
%% It goes on.
qui back [dyn] : act -o done.
stage act {
  %% It takes p one way or the other.
  back [dyn] : p -o (q @w 0.5 | () @w 0.5).
}
stage done {
  %% It takes p, there.
  bb [dyn] : p -o ().
}
#init p 3
#steps 4
