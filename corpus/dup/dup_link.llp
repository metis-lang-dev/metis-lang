% dup_link: two links of one name in one file: refused; both were live.
catalog dup_link 1.
provenance text "the duplicate link scenes (spec/18 §4)" "2026-11-02".
layers (dyn).
stages (act done).
namespace d produce (dyn).
pred p : d.
stage act {
  %% It takes p.
  aa [dyn] : p -o ().
}
stage done {
  %% It takes p, there.
  bb [dyn] : p -o ().
}
%% It goes on.
qui back [dyn] : act -o done.
%% It goes back, under the same name.
qui back [dyn] : done -o act.
#init p 3
#steps 4
