# SPDX-License-Identifier: Apache-2.0
# The C++ metis measure core (header-only) + the golden parity engine.
# Rehomed from archive/metis cpp/BUILD.bazel (runtime-binding step 1) for
# the Bazel consumers; CMakeLists.txt is the primary build (metis_rt, the
# tools, ctest).
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "metis_kernel",
    hdrs = [
        "include/metis/blackboard.hpp",
        "include/metis/evaluator.hpp",
        "include/metis/golden.hpp",
        "include/metis/ir.hpp",
        "include/metis/kernel.hpp",
        "include/metis/live.hpp",
        "include/metis/loader.hpp",
        "include/metis/plan.hpp",
        "include/metis/registry.hpp",
        "include/metis/sample_golden.hpp",
        "include/metis/sampler.hpp",
    ],
    includes = ["include"],
    copts = ["-std=c++17"],
)

# libmetis_rt's C ABI (c/metis_rt.h) for the Bazel consumers: a C or C++ device host (perotheia-packages/road's
# RoadDomain, road-domain s-707ac5dd) links this instead of the CMake shared library; the same translation unit.
cc_library(
    name = "metis_rt",
    srcs = ["c/metis_rt.cpp"],
    hdrs = ["c/metis_rt.h"],
    includes = ["c"],
    copts = ["-std=c++17"],
    deps = [":metis_kernel"],
)
